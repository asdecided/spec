{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asdecided.com/spec/schema/code-constraints.schema.json",
  "title": "As Decided code constraints",
  "description": "Deterministic source-code constraints carried by a decision artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules"],
  "properties": {
    "version": {
      "const": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path_glob", "pattern"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "forbid_pattern",
            "require_pattern",
            "forbid_import"
          ]
        },
        "path_glob": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
